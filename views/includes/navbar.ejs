<style>

/* Navbar */

.navbar{

    background:#fff !important;
    min-height:85px;
    box-shadow:0 2px 15px rgba(0,0,0,0.08);
    z-index:1000;

}



.navbar-brand img{

    width:160px;
    height:120px;
    object-fit:contain;
    transition:.3s;

}


.navbar-brand img:hover{

    transform:scale(1.05);

}



/* Links */


.nav-link{

    color:#333 !important;
    font-weight:500;
    margin:0 8px;
    transition:.3s;
    white-space:nowrap;

}


.nav-link:hover{

    color:#ff385c !important;

}





/* Search */


.search-container{

    flex:1;
    display:flex;
    justify-content:center;

}



.search-form{

    width:360px;
    height:48px;
    border:1px solid #ddd;
    border-radius:50px;
    display:flex;
    align-items:center;
    background:white;
    padding:4px;
    box-shadow:0 2px 10px rgba(0,0,0,.08);

}



.search-input{

    border:none !important;
    outline:none !important;
    box-shadow:none !important;
    border-radius:50px;
    padding-left:20px;
    flex:1;

}



.search-btn{

    background:#ff385c;
    color:white;
    border:none;
    border-radius:50px;
    padding:10px 20px;
    font-weight:600;
    transition:.3s;

}



.search-btn:hover{

    background:#e31c5f;
    color:white;

}





/* Mobile */


@media(max-width:992px){


.navbar{

    height:auto;
    padding:10px 0;

}



.navbar-collapse{

    background:white;
    padding:20px;
    border-radius:15px;
    margin-top:10px;
    box-shadow:0 10px 25px rgba(0,0,0,.1);

}



.search-container{

    width:100%;
    margin:15px 0;

}



.search-form{

    width:100%;

}



.nav-link{

    padding:12px 0;

}



}





@media(max-width:576px){


.navbar-brand img{

    width:110px;
    height:80px;

}



.search-btn span{

    display:none;

}



}

</style>





<nav class="navbar navbar-expand-md sticky-top">


<div class="container-fluid px-4">



<!-- Logo -->

<a class="navbar-brand" href="/home">

<img 
src="/images/WanderLust_transparent-.png"
alt="WanderLust Logo">

</a>





<!-- Mobile Toggle -->

<button 
class="navbar-toggler"
type="button"
data-bs-toggle="collapse"
data-bs-target="#navbarNavAltMarkup">


<span class="navbar-toggler-icon"></span>


</button>







<div class="collapse navbar-collapse" id="navbarNavAltMarkup">





<!-- Left -->

<div class="navbar-nav">


<a class="nav-link" href="/listings">

<i class="fa-solid fa-compass"></i>

Explore

</a>


</div>









<!-- SEARCH -->

<div class="search-container">


<form 
action="/listings/search"
method="GET"
class="search-form">


<input

class="form-control search-input"

type="search"

name="query"

placeholder="Search destinations">


<button 
class="btn search-btn"
type="submit">


<i class="fa-solid fa-magnifying-glass"></i>


<span>

Search

</span>


</button>


</form>



</div>









<!-- Right Side -->


<div class="navbar-nav ms-auto">



<a class="nav-link" href="/listings/new">

<i class="fa-solid fa-house"></i>

Become a host

</a>






<% if (!currUser) { %>


<a class="nav-link" href="/signup">

<b>Sign Up</b>

</a>



<a class="nav-link" href="/login">

<b>Login</b>

</a>



<% } %>








<% if(currUser){ %>


<a class="nav-link" href="/listings/bookings">


<i class="fa-solid fa-calendar-check"></i>

My Bookings


</a>




<a class="nav-link text-danger" href="/logout">


<i class="fa-solid fa-right-from-bracket"></i>

Logout


</a>




<% } %>




</div>



</div>



</div>


</nav>