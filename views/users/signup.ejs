<% layout('/layouts/boilerplate') %>

<div class="row mt-3 offset-2">
    <h1 class="col-6 offset-2"> SignUp On WanderLust</h1>
    <div class="col-6 offset-2">
        <form action="/signup" method="post" class="needs-validation" novalidate>
            <div class="mt-3">
            <label for="username" class="form-label">UserName</label>
            <input name="username" id="username"  type="text" id="title" class="form-control" required>
            <div class="invalid-feedback">
                Looks Good.
            </div>
            </div>

        
        <div class="mt-3">
            <label for="email" class="form-label">Email</label>
            <input name="email" id="email"  type="text" id="title" class="form-control" required>
            
        </div>
        
        <div class="mt-3">
            <label for="password" class="form-label">Password</label>
            <input name="password" id="password"  type="password" id="title" class="form-control" required>
            

        </div>
        <button class="btn btn-success mt-3">SignUp</button>

        </form>
        <div class="mt-3" >
            <p>Have an Account? <a href="/login" style="text-decoration: none;">login</a></p>
        </div>
        
    </div>
</div>