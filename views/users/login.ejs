<% layout('/layouts/boilerplate') %>

<div class="row mt-3 offset-2">
    <h1 class="col-6 offset-2"> Login</h1>
    <div class="col-6 offset-2">
        <form action="/login" method="post" class="needs-validation" novalidate>
            <div class="mt-3">
            <label for="username" class="form-label">UserName</label>
            <input name="username" id="username"  type="text" id="title" class="form-control" required>
            
            </div>       
        
        <div class="mt-3">
            <label for="password" class="form-label">Password</label>
            <input name="password" id="password"  type="password" id="title" class="form-control" required>
            

        </div>
        <button class="btn btn-success mt-3">Login</button>

        </form>
        
    </div>
</div>