<% layout('/layouts/boilerplate') %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
        <h3>Edit Your Details Here</h3>
        <form method="post" action="/listings/<%=l1._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mt-3">
                <label for="title" class="form-label">Enter Title</label>
                <input name="listing[title]" value="<%=l1.title %>" type="text" id="title" class="form-control" required>
                <div class="invalid-feedback">
                     Title Required.
                </div>

            </div>

            

            <div class="mt-3">
                <label for="description" class="form-label">Enter Description</label>
                <textarea type="text" name="listing[description]" id="description" class="form-control" required ><%=l1.description %> </textarea>
                <div class="invalid-feedback">
        Please Enter Description.
      </div>
            </div>
            <div class="mb-3">
                Original Image 
                <br>
                <img src="<%=originalUrl%>" alt="immage" height="300" width="250">
            </div>

            
            <div class="mt-3">
                <label for="image" class="form-label">Upload New Image Here</label>
                <input name="listing[image]"  type="file" id="image" class="form-control">
            </div>

            
           
            <div class="row mt-3">
            <div class="col-md-4">
                <label for="price" class="form-label">Enter Price</label>
                <input  name="listing[price]" value="<%=l1.price %>" type="number" id="price" class="form-control" required>
                <div class="invalid-feedback">
        Please Enter a Price.
      </div>
            </div>
            
            

            <div class="col-md-8">
                <label for="location" class="form-label">Enter Location</label>
                <input type="text" name="listing[location]" value="<%=l1.location %>" id="location" class="form-control" required>
                <div class="invalid-feedback">
        Please Enter a Location.
      </div>
            </div>
            </div>
            

            <div class="mt-3">
                <label for="country" class="form-label">Enter Country</label>
                <input type="text" name="listing[country]" value="<%=l1.country %>" id="country" class="form-control" required>
                <div class="invalid-feedback">
        Please Enter a Country.
      </div>
                
            </div>


            <div class="mb-3">
    <label class="form-label"><b>Select Category</b></label>

    <div class="category-box">

        <label class="category-item">
            <input
                type="radio"
                name="listing[category]"
                value="Rooms"
                <%= l1.category === "Rooms" ? "checked" : "" %>
                required
            >
            <span><i class="fa-solid fa-bed"></i> Rooms</span>
        </label>

        <label class="category-item">
            <input
                type="radio"
                name="listing[category]"
                value="Mountains"
                <%= l1.category === "Mountains" ? "checked" : "" %>
            >
            <span><i class="fa-solid fa-mountain"></i> Mountains</span>
        </label>

        <label class="category-item">
            <input
                type="radio"
                name="listing[category]"
                value="Castles"
                <%= l1.category === "Castles" ? "checked" : "" %>
            >
            <span><i class="fa-brands fa-fort-awesome"></i> Castles</span>
        </label>

        <label class="category-item">
            <input
                type="radio"
                name="listing[category]"
                value="Camping"
                <%= l1.category === "Camping" ? "checked" : "" %>
            >
            <span><i class="fa-solid fa-campground"></i> Camping</span>
        </label>

        <label class="category-item">
            <input
                type="radio"
                name="listing[category]"
                value="Farms"
                <%= l1.category === "Farms" ? "checked" : "" %>
            >
            <span><i class="fa-solid fa-cow"></i> Farms</span>
        </label>

        <label class="category-item">
            <input
                type="radio"
                name="listing[category]"
                value="Beach"
                <%= l1.category === "Beach" ? "checked" : "" %>
            >
            <span><i class="fa-solid fa-umbrella-beach"></i> Beach</span>
        </label>

        <label class="category-item">
            <input
                type="radio"
                name="listing[category]"
                value="Arctic"
                <%= l1.category === "Arctic" ? "checked" : "" %>
            >
            <span><i class="fa-solid fa-snowflake"></i> Arctic</span>
        </label>

    </div>
</div>
            
            
            <button class="btn btn-dark  mt-3" style="background-color: rgb(181, 25, 25); border: none;">Edit</button>
            <br>
            <br>
            


        </form>
    </div>
    </div>
    
</body>
