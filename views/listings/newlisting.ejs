
<% layout('/layouts/boilerplate') %>

<body>
    
    <div class="row">
        <div class="col-8 offset-2">
    <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
        
        <h3>Create a New Listing </h3>
        <div class="mt-3">
            <label for="title" class="form-label">Enter Title</label>
            <input name="listing[title]" placeholder="enter title" type="text" id="title" class="form-control" required>
            <div class="invalid-feedback">
        Title Required.
      </div>

        </div>
        
        
        <div class="mt-3">
            <label for="description" class="form-label">Enter Description</label>
            <textarea type="text" name="listing[description]" id="description" class="form-control" required >enter your description </textarea>
            <div class="invalid-feedback">
        Please Enter Description.
      </div>
        </div>
        
        
        <div  class="mt-3">
            <label for="image" class="form-label">Upload image</label>
             <input name="listing[image]"  type="file" id="image" class="form-control" required>
             
        </div>
       
        

        <div class="row mt-3">
        <div class="col-md-4">
            <label for="price" class="form-label">Enter Price</label>
            <input  name="listing[price]" placeholder="enter your price "  id="price" class="form-control" required>
            <div class="invalid-feedback">
        Please Enter a Price.
      </div>
        </div>
        
        
        
        <div class="col-md-8">
            <label for="location" class="form-label">Enter Location</label>
            <input type="text" name="listing[location]" placeholder="enter location details" id="location" class="form-control" required>
            <div class="invalid-feedback">
        Please Enter a Location.
      </div>
        </div>
        
        
        </div>
        <div class="mt-3">
            <label for="country" class="form-label">Enter Country</label>
            <input type="text" name="listing[country]" placeholder="enter country" id="country" class="form-control"  required>
            <div class="invalid-feedback">
        Please Enter a Country.
      </div>
        </div>

        <br>
        <br>
        <div class="mb-3">
    <label class="form-label"><b>Select Category</b></label>

    <div class="category-box" >

        <label class="category-item" >
            <input type="radio" name="listing[category]" value="Rooms" required>
            <span><i class="fa-solid fa-bed"></i> Rooms</span>
        </label>

        

        <label class="category-item">
            <input type="radio" name="listing[category]" value="Mountains">
            <span><i class="fa-solid fa-mountain"></i> Mountains</span>
        </label>

        <label class="category-item">
            <input type="radio" name="listing[category]" value="Castles">
            <span><i class="fa-brands fa-fort-awesome"></i> Castles</span>
        </label>

        

        <label class="category-item">
            <input type="radio" name="listing[category]" value="Camping">
            <span><i class="fa-solid fa-campground"></i> Camping</span>
        </label>

        <label class="category-item">
            <input type="radio" name="listing[category]" value="Farms">
            <span><i class="fa-solid fa-cow"></i> Farms</span>
        </label>

        <label class="category-item">
            <input type="radio" name="listing[category]" value="Beach">
            <span><i class="fa-solid fa-umbrella-beach"></i> Beach</span>
        </label>

        <label class="category-item">
            <input type="radio" name="listing[category]" value="Arctic">
            <span><i class="fa-solid fa-snowflake"></i> Arctic</span>
        </label>

    </div>
</div>


        
        
        <button class="btn btn-dark mt-3" style="background-color: rgb(181, 25, 25); border: none;">Add</button>
        <br>
        <br>
        


    </form>
    </div>
    </div>
</body>




